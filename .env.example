# OpenRouter AI API Key
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# Mapbox API Key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here

# Weather API Key
WEATHER_API_KEY=your-weather-api-key-here

# Flask Secret Key
FLASK_SECRET_KEY=generate-a-secret-key

# Flask Configuration
FLASK_DEBUG=True
FLASK_PORT=5000

# Telegram high-risk notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=300
